# ==============================================================================
# Dependências e Builds do Frontend (Node / Vite / pnpm)
# ==============================================================================
node_modules/
dist/
dist-ssr/
*.local
.vite/

# Logs de gerenciadores de pacote
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==============================================================================
# Python (Bytecode, Caches, Ambientes Virtuais)
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Ambientes virtuais
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Distribuição e empacotamento Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==============================================================================
# Variáveis de Ambiente e Segredos (Segurança Crítica)
# ==============================================================================
.env
.env*.local
.env.development
.env.test
.env.production
# Permite o versionamento do arquivo modelo
!.env.example

# ==============================================================================
# Caches de Testes e Ferramentas
# ==============================================================================
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ==============================================================================
# Sistema Operacional e Editores (IDEs)
# ==============================================================================
